# Telegram
TELEGRAM_TOKEN=your_telegram_bot_token

# AI APIs
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/content_factory.db

# App settings
REQUIRE_OWNER_APPROVAL=false
RATE_LIMIT_PER_MINUTE=5

# Initial users (comma-separated telegram_id:role:full_name)
# Roles: marketer | foreman | owner
INITIAL_USERS=123456789:marketer:Дмитрий,987654321:foreman:Бригадир,111222333:owner:Владелец

# VK (Phase 2 — optional for MVP)
VK_COMMUNITY_TOKEN=
VK_GROUP_ID=
